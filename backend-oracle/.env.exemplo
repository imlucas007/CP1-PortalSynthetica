# Copie este arquivo para ".env" e preencha com os dados do servidor Oracle.
# Nunca envie o .env para o Git - ele contem a senha!

ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_HOST=servidor.escola.com.br
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# Origens liberadas no CORS (o front do Portal Synthetica roda no Vite, :5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
